<?xml version="1.0"?>
<resources>
  <style name="base_dialog" parent="android:style/Theme.Dialog">
    <item name="android:statusBarColor">#00000000</item>

    <style name="base_dialog" parent="android:style/Theme.Dialog">
        <item name="android:statusBarColor">#00000000</item>  <!-- Status栏color -->
        <item name="android:windowFrame">@null</item>         <!-- 边框 -->
        <item name="android:windowIsFloating">false</item>    <!-- 是否浮现在activity之上 -->
        <item name="android:windowNoTitle">true</item>        <!-- 是否无Title -->
        <item name="android:windowIsTranslucent">false</item> <!-- 是否半透明 -->
        <item name="android:windowBackground">#00000000</item><!-- 背景color-透明 -->
        <item name="android:backgroundDimEnabled">true</item> <!-- 对话框之外的背景是否模糊 -->
    </style>

    <item name="android:windowIsFloating">false</item>

    <item name="android:windowNoTitle">true</item>

    <item name="android:windowIsTranslucent">false</item>

    <item name="android:windowBackground">#00000000</item>

    <item name="android:backgroundDimEnabled">true</item>

  </style>

  <style name="transparent_dialog" parent="base_dialog">
    <item name="android:backgroundDimEnabled">false</item>

    <style name="TextInputDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>        <!-- 边框 -->
        <item name="android:windowIsFloating">true</item>   <!-- 是否浮现在activity之上 -->
        <item name="android:windowNoTitle">true</item>       <!-- 是否无Title -->
        <item name="android:windowIsTranslucent">false</item><!-- 是否半透明 -->
        <item name="android:windowBackground">@android:color/transparent</item><!-- 背景color-透明 -->
        <item name="android:backgroundDimEnabled">true</item><!-- 对话框之外的背景是否模糊 -->
        <item name="android:windowSoftInputMode">stateAlwaysVisible|adjustPan</item>
    </style>

    <style name="DefaultDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>        <!-- 边框 -->
        <item name="android:windowIsFloating">false</item>   <!-- 是否浮现在activity之上 -->
        <item name="android:windowNoTitle">true</item>       <!-- 是否无Title -->
        <item name="android:windowIsTranslucent">false</item><!-- 是否半透明 -->
        <item name="android:windowBackground">@android:color/transparent</item><!-- 背景color-透明 -->
        <item name="android:backgroundDimEnabled">true</item><!-- 对话框之外的背景是否模糊 -->
    </style>

    <!-- 透明dialog style -->
    <style name="TransparentDialog" parent="AppTheme">
        <item name="android:windowFrame">@null</item>         <!-- 边框 -->
        <item name="android:windowIsFloating">false</item>    <!-- 是否浮现在activity之上 -->
        <item name="android:windowNoTitle">true</item>        <!-- 是否无Title -->
        <item name="android:windowIsTranslucent">true</item>  <!-- 是否半透明 -->
        <item name="android:windowBackground">@android:color/transparent</item><!-- 背景color-透明 -->
        <item name="android:backgroundDimEnabled">false</item><!-- 对话框之外的背景是否模糊 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <item name="android:windowNoTitle">true</item>

    <item name="android:windowIsTranslucent">false</item>

    <item name="android:windowBackground">@android:color/transparent</item>

    <item name="android:backgroundDimEnabled">true</item>

    <item name="android:windowSoftInputMode">stateAlwaysVisible|adjustPan</item>
  </style>
  <style name="DefaultDialog" parent="@android:style/Theme.Dialog">
    <item name="android:windowFrame">@null</item>

    <item name="android:windowIsFloating">false</item>

    <item name="android:windowNoTitle">true</item>

    <item name="android:windowIsTranslucent">false</item>

    <item name="android:windowBackground">@android:color/transparent</item>

    <item name="android:backgroundDimEnabled">true</item>

  </style>

  <style name="TransparentDialog" parent="AppTheme">
    <item name="android:windowFrame">@null</item>

    <item name="android:windowIsFloating">false</item>

    <item name="android:windowNoTitle">true</item>

    <item name="android:windowIsTranslucent">true</item>

    <item name="android:windowBackground">@android:color/transparent</item>

    <item name="android:backgroundDimEnabled">false</item>

    <item name="android:statusBarColor">@android:color/transparent</item>
  </style>
  <style name="cameraSetSwitch" parent="Theme.AppCompat.Light">
    <item name="android:background">@null</item>
    <item name="android:thumb">@drawable/switch_thumb_ios</item>
    <item name="track">@drawable/switch_track_ios</item>
  </style>
</resources>
