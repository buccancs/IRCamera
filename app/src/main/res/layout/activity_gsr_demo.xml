<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
    </data>
<LinearLayout xmlns:ns0="http://schemas.android.com/apk/res/android" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:orientation="vertical" ns0:padding="32dp">
  
  <TextView ns0:id="@+id/title_text" ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="GSR Recording Demo" ns0:textSize="24sp" ns0:paddingBottom="32dp" />
  
  <TextView ns0:id="@+id/description_text" ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="Demonstrates 128 Hz GSR data recording with CSV export and sync events." ns0:paddingBottom="24dp" />
  
  <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="horizontal">
    <Button ns0:id="@+id/start_button" ns0:layout_width="0dp" ns0:layout_height="wrap_content" ns0:layout_weight="1" ns0:text="Start Recording" ns0:layout_marginEnd="8dp" />
    <Button ns0:id="@+id/stop_button" ns0:layout_width="0dp" ns0:layout_height="wrap_content" ns0:layout_weight="1" ns0:text="Stop Recording" ns0:enabled="false" ns0:layout_marginEnd="8dp" />
    <Button ns0:id="@+id/sync_button" ns0:layout_width="0dp" ns0:layout_height="wrap_content" ns0:layout_weight="1" ns0:text="Sync Event" ns0:enabled="false" />
  </LinearLayout>
  
  <TextView ns0:id="@+id/status_text" ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="Ready to record" ns0:textSize="16sp" ns0:paddingTop="32dp" ns0:paddingBottom="16dp" />
  
  <TextView ns0:id="@+id/data_text" ns0:layout_width="match_parent" ns0:layout_height="0dp" ns0:layout_weight="1" ns0:text="No data yet. Press 'Start Recording' to begin." ns0:background="@android:drawable/editbox_background" ns0:padding="16dp" ns0:typeface="monospace" />
</LinearLayout>
</layout>