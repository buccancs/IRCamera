      <androidx.recyclerview.widget.RecyclerView ns0:id="@+id/controllers_recycler_view" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:scrollbars="vertical" />
    </LinearLayout>
  </androidx.cardview.widget.CardView>

  <View ns0:id="@+id/flash_overlay" ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:background="#ffffff" ns0:visibility="gone" ns0:alpha="0" ns2:layout_constraintBottom_toBottomOf="parent" ns2:layout_constraintEnd_toEndOf="parent" ns2:layout_constraintStart_toStartOf="parent" ns2:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>