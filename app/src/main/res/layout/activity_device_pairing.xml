  <androidx.cardview.widget.CardView ns0:id="@+id/controllers_card" ns0:layout_width="0dp" ns0:layout_height="0dp" ns0:layout_margin="16dp" ns2:cardBackgroundColor="#2a2a2a" ns2:cardCornerRadius="8dp" ns2:cardElevation="2dp" ns2:layout_constraintBottom_toBottomOf="parent" ns2:layout_constraintEnd_toEndOf="parent" ns2:layout_constraintStart_toStartOf="parent" ns2:layout_constraintTop_toBottomOf="@id/scan_card">
    <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="match_parent" ns0:orientation="vertical" ns0:padding="16dp">
