      <TextView ns0:id="@+id/status_text" ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="Ready to scan" ns0:textColor="#aaffffff" ns0:textSize="12sp" ns0:layout_marginTop="8dp" />
