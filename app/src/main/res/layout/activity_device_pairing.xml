  <androidx.cardview.widget.CardView ns0:id="@+id/scan_card" ns0:layout_width="0dp" ns0:layout_height="wrap_content" ns0:layout_margin="16dp" ns2:cardBackgroundColor="#2a2a2a" ns2:cardCornerRadius="8dp" ns2:cardElevation="2dp" ns2:layout_constraintEnd_toEndOf="parent" ns2:layout_constraintStart_toStartOf="parent" ns2:layout_constraintTop_toBottomOf="@id/status_card">
    <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="vertical" ns0:padding="16dp">
      <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="PC Controller Discovery" ns0:textColor="#ffffff" ns0:textSize="18sp" ns0:textStyle="bold" ns0:layout_marginBottom="8dp" />
      <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="Scan your local network to find available PC Controllers for remote measurement sessions." ns0:textColor="#ccffffff" ns0:textSize="14sp" ns0:layout_marginBottom="16dp" />
      <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="horizontal" ns0:gravity="center_vertical">
        <Button ns0:id="@+id/scan_button" ns0:layout_width="wrap_content" ns0:layout_height="wrap_content" ns0:text="Scan Network" ns0:backgroundTint="@color/colorAccent" ns0:textColor="#ffffff" ns0:layout_marginEnd="16dp" />
        <ProgressBar ns0:id="@+id/progress_bar" ns0:layout_width="24dp" ns0:layout_height="24dp" ns0:visibility="gone" style="@android:style/Widget.Material.ProgressBar" />
