        <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="System Status" ns0:textSize="18sp" ns0:textStyle="bold" ns0:layout_marginBottom="12dp" ns0:textColor="@android:color/black" />
