    <androidx.cardview.widget.CardView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:layout_marginTop="16dp" ns2:cardCornerRadius="8dp" ns2:cardElevation="4dp">
      <LinearLayout ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:orientation="vertical" ns0:padding="16dp">
        <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="Hub-Spoke System Info" ns0:textSize="18sp" ns0:textStyle="bold" ns0:layout_marginBottom="12dp" ns0:textColor="@android:color/black" />
        <TextView ns0:layout_width="match_parent" ns0:layout_height="wrap_content" ns0:text="This demonstration shows the complete Multi-Modal Physiological Sensing Platform with Hub-and-Spoke architecture.\n\n• Hub: PC Controller for data aggregation\n• Spoke: Android Sensor Node for data capture\n• Sensors: RGB Camera, Thermal Camera, GSR\n• Sync: Sub-5ms temporal synchronization\n• Network: TLS-secured communication" ns0:textSize="12sp" ns0:lineSpacingMultiplier="1.2" ns0:textColor="@android:color/darker_gray" />
      </LinearLayout>
    </androidx.cardview.widget.CardView>
  </LinearLayout>
</ScrollView>
</layout>