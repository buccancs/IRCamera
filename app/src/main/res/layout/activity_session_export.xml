<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context="com.topdon.tc001.gsr.SessionExportActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/activity_horizontal_margin">

        <!-- Export Options Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/export_format_options"
                    android:textAppearance="?android:textAppearanceLarge"
                    android:textStyle="bold"
                    android:contentDescription="@string/export_format_options_description" />

                <!-- CSV Format Option -->
                <CheckBox
                    android:id="@+id/export_csv_checkbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/export_csv_format"
                    android:checked="true"
                    android:contentDescription="@string/csv_format_description" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/csv_format_details"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

                <!-- JSON Format Option -->
                <CheckBox
                    android:id="@+id/export_json_checkbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/export_json_format"
                    android:contentDescription="@string/json_format_description" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/json_format_details"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

                <!-- Research Metadata Option -->
                <CheckBox
                    android:id="@+id/export_metadata_checkbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/export_research_metadata"
                    android:checked="true"
                    android:contentDescription="@string/research_metadata_description" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/metadata_format_details"
                    android:textAppearance="?android:textAppearanceSmall"
                    android:textColor="?android:textColorSecondary" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Session Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/session_to_export"
                    android:textAppearance="?android:textAppearanceLarge"
                    android:textStyle="bold"
                    android:contentDescription="@string/session_to_export_description" />

                <TextView
                    android:id="@+id/export_session_id_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?android:textAppearanceMedium"
                    tools:text="Session ID: ABC123"
                    android:contentDescription="@string/session_id_description" />

                <TextView
                    android:id="@+id/export_estimated_size_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?android:textAppearanceMedium"
                    tools:text="Estimated export size: 12.5 MB"
                    android:contentDescription="@string/estimated_size_description" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Export Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/start_export_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/start_export"
                android:contentDescription="@string/start_export_description" />

            <ProgressBar
                android:id="@+id/export_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:contentDescription="@string/export_progress_description" />

            <TextView
                android:id="@+id/export_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textAppearance="?android:textAppearanceSmall"
                android:gravity="center"
                android:visibility="gone"
                tools:text="Exporting... 45%"
                android:contentDescription="@string/export_status_description" />

        </LinearLayout>

        <!-- Coming Soon Notice -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/export_functionality_coming_soon"
            android:textAppearance="?android:textAppearanceSmall"
            android:textStyle="italic"
            android:gravity="center"
            android:contentDescription="@string/coming_soon_description" />

    </LinearLayout>

</ScrollView>