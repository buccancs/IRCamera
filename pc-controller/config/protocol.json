{
  "common_fields": {
    "correlation_id": {
      "description": "ID to correlate request/response pairs",
      "required": false,
      "type": "string"
    },
    "message_id": {
      "description": "Unique identifier for message (UUID recommended)",
      "required": false,
      "type": "string"
    },
    "message_type": {
      "description": "Type of message being sent",
      "required": true,
      "type": "string"
    },
    "timestamp": {
      "description": "ISO 8601 timestamp when message was created",
      "format": "date-time",
      "required": true,
      "type": "string"
    }
  },
  "message_types": {
    "device_lifecycle": {
      "device_heartbeat": {
        "description": "Device heartbeat message",
        "direction": "device_to_pc",
        "optional_fields": [
          "battery_level",
          "state",
          "current_session_id"
        ],
        "required_fields": [
          "device_id"
        ],
        "schema": {
          "properties": {
            "battery_level": {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "current_session_id": {
              "type": "string"
            },
            "device_id": {
              "type": "string"
            },
            "message_type": {
              "const": "device_heartbeat",
              "type": "string"
            },
            "state": {
              "enum": [
                "idle",
                "recording",
                "error"
              ],
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "device_register": {
        "description": "Device registration message",
        "direction": "device_to_pc",
        "optional_fields": [
          "battery_level",
          "gsr_mode",
          "device_name"
        ],
        "required_fields": [
          "device_id",
          "device_type",
          "capabilities",
          "ip_address",
          "port"
        ],
        "schema": {
          "properties": {
            "battery_level": {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "capabilities": {
              "items": {
                "enum": [
                  "thermal",
                  "visual",
                  "depth",
                  "audio",
                  "gsr",
                  "imu",
                  "gps"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "device_id": {
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            "device_name": {
              "maxLength": 64,
              "type": "string"
            },
            "device_type": {
              "enum": [
                "android_phone",
                "android_tablet",
                "thermal_camera",
                "depth_camera"
              ],
              "type": "string"
            },
            "gsr_mode": {
              "enum": [
                "local",
                "bridged"
              ],
              "type": "string"
            },
            "ip_address": {
              "format": "ipv4",
              "type": "string"
            },
            "message_type": {
              "const": "device_register",
              "type": "string"
            },
            "port": {
              "maximum": 65535,
              "minimum": 1024,
              "type": "integer"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "device_status": {
        "description": "Device status update message",
        "direction": "device_to_pc",
        "optional_fields": [
          "error_message",
          "data_stats"
        ],
        "required_fields": [
          "device_id",
          "status"
        ],
        "schema": {
          "properties": {
            "data_stats": {
              "properties": {
                "samples_recorded": {
                  "type": "integer"
                },
                "storage_available_mb": {
                  "type": "number"
                },
                "storage_used_mb": {
                  "type": "number"
                }
              },
              "type": "object"
            },
            "device_id": {
              "type": "string"
            },
            "error_message": {
              "type": "string"
            },
            "message_type": {
              "const": "device_status",
              "type": "string"
            },
            "status": {
              "enum": [
                "ready",
                "recording",
                "transferring",
                "error",
                "low_battery"
              ],
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    },
    "file_transfer": {
      "file_chunk": {
        "description": "File data chunk message",
        "direction": "device_to_pc",
        "optional_fields": [
          "is_final_chunk",
          "chunk_checksum"
        ],
        "required_fields": [
          "transfer_id",
          "chunk_index",
          "chunk_data"
        ],
        "schema": {
          "properties": {
            "chunk_checksum": {
              "type": "string"
            },
            "chunk_data": {
              "contentEncoding": "base64",
              "type": "string"
            },
            "chunk_index": {
              "minimum": 0,
              "type": "integer"
            },
            "is_final_chunk": {
              "default": false,
              "type": "boolean"
            },
            "message_type": {
              "const": "file_chunk",
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            },
            "transfer_id": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "file_transfer_complete": {
        "description": "File transfer completion notification",
        "direction": "device_to_pc",
        "optional_fields": [
          "error_message",
          "bytes_transferred"
        ],
        "required_fields": [
          "device_id",
          "transfer_id",
          "status"
        ],
        "schema": {
          "properties": {
            "bytes_transferred": {
              "minimum": 0,
              "type": "integer"
            },
            "device_id": {
              "type": "string"
            },
            "error_message": {
              "type": "string"
            },
            "message_type": {
              "const": "file_transfer_complete",
              "type": "string"
            },
            "status": {
              "enum": [
                "success",
                "error",
                "cancelled"
              ],
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            },
            "transfer_id": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "file_transfer_request": {
        "description": "File transfer request message",
        "direction": "device_to_pc",
        "optional_fields": [
          "session_id",
          "priority"
        ],
        "required_fields": [
          "device_id",
          "file_info"
        ],
        "schema": {
          "properties": {
            "device_id": {
              "type": "string"
            },
            "file_info": {
              "properties": {
                "checksum": {
                  "type": "string"
                },
                "checksum_algorithm": {
                  "default": "sha256",
                  "enum": [
                    "sha256",
                    "md5"
                  ],
                  "type": "string"
                },
                "compression": {
                  "enum": [
                    "none",
                    "gzip",
                    "lz4"
                  ],
                  "type": "string"
                },
                "encoding": {
                  "default": "utf-8",
                  "type": "string"
                },
                "file_size": {
                  "minimum": 0,
                  "type": "integer"
                },
                "file_type": {
                  "enum": [
                    "thermal",
                    "visual",
                    "depth",
                    "audio",
                    "gsr",
                    "imu",
                    "metadata"
                  ],
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                }
              },
              "required": [
                "filename",
                "file_type",
                "file_size",
                "checksum"
              ],
              "type": "object"
            },
            "message_type": {
              "const": "file_transfer_request",
              "type": "string"
            },
            "priority": {
              "default": 5,
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            "session_id": {
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    },
    "gsr_data": {
      "gsr_data_batch": {
        "description": "Batch of GSR sensor data",
        "direction": "device_to_pc",
        "optional_fields": [
          "session_id",
          "quality_metrics"
        ],
        "required_fields": [
          "device_id",
          "data_points"
        ],
        "schema": {
          "properties": {
            "data_points": {
              "items": {
                "properties": {
                  "quality": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "timestamp": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "unit": {
                    "default": "microsiemens",
                    "enum": [
                      "microsiemens",
                      "ohms"
                    ],
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": [
                  "timestamp",
                  "value"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "device_id": {
              "type": "string"
            },
            "message_type": {
              "const": "gsr_data_batch",
              "type": "string"
            },
            "quality_metrics": {
              "properties": {
                "avg_quality": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                },
                "noise_level": {
                  "type": "number"
                },
                "saturation_rate": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "type": "object"
            },
            "session_id": {
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "gsr_leader_election": {
        "description": "GSR leader election message",
        "direction": "bidirectional",
        "optional_fields": [
          "priority_score",
          "capabilities"
        ],
        "required_fields": [
          "device_id",
          "election_type"
        ],
        "schema": {
          "properties": {
            "capabilities": {
              "properties": {
                "bridged_mode_support": {
                  "type": "boolean"
                },
                "quality_filtering": {
                  "type": "boolean"
                },
                "sampling_rates": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "device_id": {
              "type": "string"
            },
            "election_type": {
              "enum": [
                "candidate",
                "leader",
                "acknowledge"
              ],
              "type": "string"
            },
            "message_type": {
              "const": "gsr_leader_election",
              "type": "string"
            },
            "priority_score": {
              "minimum": 0,
              "type": "number"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    },
    "responses": {
      "ack": {
        "description": "Acknowledgment message",
        "direction": "bidirectional",
        "optional_fields": [
          "status",
          "message"
        ],
        "required_fields": [
          "ack_for"
        ],
        "schema": {
          "properties": {
            "ack_for": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "message_type": {
              "const": "ack",
              "type": "string"
            },
            "status": {
              "default": "success",
              "enum": [
                "success",
                "error"
              ],
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "error": {
        "description": "Error message",
        "direction": "bidirectional",
        "optional_fields": [
          "context",
          "retry_after_s"
        ],
        "required_fields": [
          "error_code",
          "error_message"
        ],
        "schema": {
          "properties": {
            "context": {
              "properties": {
                "device_id": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "session_id": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "error_code": {
              "enum": [
                "INVALID_MESSAGE",
                "UNSUPPORTED_OPERATION",
                "DEVICE_BUSY",
                "SESSION_NOT_FOUND",
                "PERMISSION_DENIED",
                "RESOURCE_UNAVAILABLE",
                "TIMEOUT"
              ],
              "type": "string"
            },
            "error_message": {
              "type": "string"
            },
            "message_type": {
              "const": "error",
              "type": "string"
            },
            "retry_after_s": {
              "minimum": 1,
              "type": "integer"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    },
    "session_control": {
      "recording_start": {
        "description": "Start recording command",
        "direction": "pc_to_device",
        "optional_fields": [
          "start_timestamp",
          "recording_duration_s"
        ],
        "required_fields": [
          "session_id"
        ],
        "schema": {
          "properties": {
            "message_type": {
              "const": "recording_start",
              "type": "string"
            },
            "recording_duration_s": {
              "minimum": 1,
              "type": "integer"
            },
            "session_id": {
              "type": "string"
            },
            "start_timestamp": {
              "format": "date-time",
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "recording_stop": {
        "description": "Stop recording command",
        "direction": "pc_to_device",
        "optional_fields": [],
        "required_fields": [
          "session_id"
        ],
        "schema": {
          "properties": {
            "message_type": {
              "const": "recording_stop",
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "session_start": {
        "description": "Start session command",
        "direction": "pc_to_device",
        "optional_fields": [
          "recording_params",
          "sync_offset_ms"
        ],
        "required_fields": [
          "session_id",
          "session_name"
        ],
        "schema": {
          "properties": {
            "message_type": {
              "const": "session_start",
              "type": "string"
            },
            "recording_params": {
              "properties": {
                "audio_sample_rate": {
                  "enum": [
                    8000,
                    16000,
                    44100,
                    48000
                  ],
                  "type": "integer"
                },
                "gsr_sample_rate": {
                  "maximum": 1000,
                  "minimum": 1,
                  "type": "integer"
                },
                "imu_sample_rate": {
                  "maximum": 1000,
                  "minimum": 1,
                  "type": "integer"
                },
                "thermal_fps": {
                  "maximum": 60,
                  "minimum": 1,
                  "type": "integer"
                },
                "visual_fps": {
                  "maximum": 60,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "session_id": {
              "type": "string"
            },
            "session_name": {
              "type": "string"
            },
            "sync_offset_ms": {
              "type": "integer"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "session_stop": {
        "description": "Stop session command",
        "direction": "pc_to_device",
        "optional_fields": [],
        "required_fields": [
          "session_id"
        ],
        "schema": {
          "properties": {
            "message_type": {
              "const": "session_stop",
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    },
    "synchronization": {
      "sync_flash": {
        "description": "Visual synchronization flash command",
        "direction": "pc_to_device",
        "optional_fields": [
          "duration_ms",
          "intensity",
          "color"
        ],
        "required_fields": [],
        "schema": {
          "properties": {
            "color": {
              "default": "white",
              "enum": [
                "white",
                "red",
                "green",
                "blue"
              ],
              "type": "string"
            },
            "duration_ms": {
              "default": 100,
              "maximum": 5000,
              "minimum": 10,
              "type": "integer"
            },
            "intensity": {
              "default": 1.0,
              "maximum": 1.0,
              "minimum": 0.1,
              "type": "number"
            },
            "message_type": {
              "const": "sync_flash",
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "sync_mark": {
        "description": "Synchronization marker message",
        "direction": "bidirectional",
        "optional_fields": [
          "metadata",
          "session_id"
        ],
        "required_fields": [
          "mark_type",
          "mark_id"
        ],
        "schema": {
          "properties": {
            "mark_id": {
              "type": "string"
            },
            "mark_type": {
              "enum": [
                "manual_mark",
                "auto_mark",
                "event_mark",
                "calibration_mark"
              ],
              "type": "string"
            },
            "message_type": {
              "const": "sync_mark",
              "type": "string"
            },
            "metadata": {
              "properties": {
                "coordinates": {
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "description": {
                  "type": "string"
                },
                "user_id": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "session_id": {
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "time_sync_request": {
        "description": "Time synchronization request",
        "direction": "device_to_pc",
        "optional_fields": [
          "client_timestamp"
        ],
        "required_fields": [
          "device_id"
        ],
        "schema": {
          "properties": {
            "client_timestamp": {
              "format": "date-time",
              "type": "string"
            },
            "device_id": {
              "type": "string"
            },
            "message_type": {
              "const": "time_sync_request",
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "time_sync_response": {
        "description": "Time synchronization response",
        "direction": "pc_to_device",
        "optional_fields": [
          "client_timestamp",
          "processing_delay_ms"
        ],
        "required_fields": [
          "server_timestamp"
        ],
        "schema": {
          "properties": {
            "client_timestamp": {
              "format": "date-time",
              "type": "string"
            },
            "message_type": {
              "const": "time_sync_response",
              "type": "string"
            },
            "processing_delay_ms": {
              "type": "number"
            },
            "server_timestamp": {
              "format": "date-time",
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      }
    },
    "system_integration": {
      "bluetooth_connect_request": {
        "description": "Request device to connect to Bluetooth device",
        "direction": "pc_to_device",
        "optional_fields": [
          "connection_timeout"
        ],
        "required_fields": [
          "target_address"
        ],
        "schema": {
          "properties": {
            "connection_timeout": {
              "maximum": 60,
              "minimum": 5,
              "type": "integer"
            },
            "message_type": {
              "const": "bluetooth_connect_request",
              "type": "string"
            },
            "target_address": {
              "pattern": "^[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}$",
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "bluetooth_connection_status": {
        "description": "Bluetooth connection status update",
        "direction": "device_to_pc",
        "optional_fields": [
          "error_message"
        ],
        "required_fields": [
          "target_address",
          "status"
        ],
        "schema": {
          "properties": {
            "error_message": {
              "type": "string"
            },
            "message_type": {
              "const": "bluetooth_connection_status",
              "type": "string"
            },
            "status": {
              "enum": [
                "connecting",
                "connected",
                "disconnected",
                "error"
              ],
              "type": "string"
            },
            "target_address": {
              "pattern": "^[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}$",
              "type": "string"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "bluetooth_scan_request": {
        "description": "Request device to scan for Bluetooth devices",
        "direction": "pc_to_device",
        "optional_fields": [
          "filter_ircamera_only"
        ],
        "required_fields": [
          "scan_duration"
        ],
        "schema": {
          "properties": {
            "filter_ircamera_only": {
              "type": "boolean"
            },
            "message_type": {
              "const": "bluetooth_scan_request",
              "type": "string"
            },
            "scan_duration": {
              "maximum": 60,
              "minimum": 5,
              "type": "integer"
            },
            "timestamp": {
              "format": "date-time",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "bluetooth_scan_result": {
        "description": "Bluetooth scan results from device",
        "direction": "device_to_pc",
        "optional_fields": [
          "scan_complete"
        ],
        "required_fields": [
          "devices"
